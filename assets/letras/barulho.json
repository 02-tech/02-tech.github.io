  {
   "t": 2.58,
   "texto": "Aí, vagabundo...",
   "estrofe": 0
  },
  {
   "t": 4.42,
   "texto": "Se tu ainda tem alguma consideração por mim...",
   "estrofe": 0
  },
  {
   "t": 8.82,
   "texto": "Não escuta essa música.",
   "estrofe": 0
  },
  {
   "t": 25.66,
   "texto": "Sinta a frieza dos meus olhos",
   "estrofe": 1
  },
  {
   "t": 27.46,
   "texto": "Eu sinto sangue na minha boca",
   "estrofe": 1
  },
  {
   "t": 29.5,
   "texto": "Não questione a minha cara",
   "estrofe": 1
  },
  {
   "t": 30.76,
   "texto": "Porque eu não tenho outra",
   "estrofe": 1
  },
  {
   "t": 32.12,
   "texto": "De madrugada, som na estrada",
   "estrofe": 1
  },
  {
   "t": 33.8,
   "texto": "Minha face aparece",
   "estrofe": 1
  },
  {
   "t": 34.74,
   "texto": "É quando ninguém tá aí",
   "estrofe": 1
  },
  {
   "t": 36.06,
   "texto": "Que minha alma escurece",
   "estrofe": 1
  },
  {
   "t": 37.56,
   "texto": "Quando cheguei em casa",
   "estrofe": 1
  },
  {
   "t": 38.45,
   "texto": "O espelho me olhava",
   "estrofe": 1
  },
  {
   "t": 40.32,
   "texto": "Lágrimas escorriam",
   "estrofe": 1
  },
  {
   "t": 41.46,
   "texto": "E a raiva me selava",
   "estrofe": 1
  },
  {
   "t": 42.84,
   "texto": "Só que eu não tava triste",
   "estrofe": 1
  },
  {
   "t": 44.12,
   "texto": "Isso tudo era raiva",
   "estrofe": 1
  },
  {
   "t": 45.52,
   "texto": "Um sentimento eterno",
   "estrofe": 1
  },
  {
   "t": 46.78,
   "texto": "Que ali me dominava",
   "estrofe": 1
  },
  {
   "t": 48.18,
   "texto": "Não veem maldade em mim",
   "estrofe": 2
  },
  {
   "t": 49.56,
   "texto": "Eu guardo maldade em mim",
   "estrofe": 2
  },
  {
   "t": 50.68,
   "texto": "São lembranças da infância",
   "estrofe": 2
  },
  {
   "t": 52.06,
   "texto": "Que me deixaram assim",
   "estrofe": 2
  },
  {
   "t": 53.42,
   "texto": "Hoje posso comprar as coisas",
   "estrofe": 2
  },
  {
   "t": 54.9,
   "texto": "Que quando moleque sonhava",
   "estrofe": 2
  },
  {
   "t": 56.42,
   "texto": "Mas não pude salvar o moleque",
   "estrofe": 2
  },
  {
   "t": 57.92,
   "texto": "Que no remorso se afogava",
   "estrofe": 2
  },
  {
   "t": 59.56,
   "texto": "Nunca disse ser um cara bom",
   "estrofe": 2
  },
  {
   "t": 61.5,
   "texto": "Mesmo com várias ações boas",
   "estrofe": 2
  },
  {
   "t": 64.26,
   "texto": "Meu espírito é mais sombrio",
   "estrofe": 2
  },
  {
   "t": 66.58,
   "texto": "Do que um poço que ecoa",
   "estrofe": 2
  },
  {
   "t": 69.1,
   "texto": "Minha mente não descansa",
   "estrofe": 2
  },
  {
   "t": 70.82,
   "texto": "Minha alma não perdoa",
   "estrofe": 2
  },
  {
   "t": 71.81,
   "texto": "Eu faço o bem com uma mão",
   "estrofe": 2
  },
  {
   "t": 73.34,
   "texto": "Enquanto a outra sangra toda",
   "estrofe": 2
  },
  {
