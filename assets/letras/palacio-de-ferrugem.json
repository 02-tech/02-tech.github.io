   "estrofe": 6
  },
  {
   "t": 193.4,
   "texto": "Os sinos não tocavam,",
   "estrofe": 7
  },
  {
   "t": 195.44,
   "texto": "só tremiam no ar.",
   "estrofe": 7
  },
  {
   "t": 197.32,
   "texto": "Havia um altar sem santo",
   "estrofe": 7
  },
  {
   "t": 199.0,
   "texto": "e um céu sem lugar.",
   "estrofe": 7
  },
  {
   "t": 200.52,
   "texto": "As velas queimavam baixo,",
   "estrofe": 7
  },
  {
   "t": 202.58,
   "texto": "como estrelas no chão.",
   "estrofe": 7
  },
  {
   "t": 204.32,
   "texto": "E uma ferramenta fria",
   "estrofe": 7
  },
  {
   "t": 206.08,
   "texto": "pedia para ser canção.",
   "estrofe": 7
  },
  {
   "t": 207.67,
   "texto": "No vitral, uma sombra",
   "estrofe": 7
  },
  {
   "t": 210.26,
   "texto": "tentava esconder a cor.",
   "estrofe": 7
  },
  {
   "t": 214.74,
   "texto": "E o homem que ninguém via",
   "estrofe": 7
  },
  {
   "t": 217.52,
   "texto": "negociava com a dor.",
   "estrofe": 7
  },
  {
   "t": 221.36,
   "texto": "Sangue nos olhos, gelo na alma,",
   "estrofe": 8
  },
  {
   "t": 223.26,
   "texto": "tudo aos poucos lhe roubava a calma.",
   "estrofe": 8
  },
  {
   "t": 225.04,
   "texto": "Coroa torta, quarto sem aplausos,",
   "estrofe": 8
  },
  {
   "t": 226.76,
   "texto": "a luta, outrora, deixava espaços.",
   "estrofe": 8
  },
  {
   "t": 228.64,
   "texto": "Tudo que brilha cobra sombra depois,",
   "estrofe": 8
  },
  {
   "t": 230.46,
   "texto": "todo gigante divide o peito em dois.",
   "estrofe": 8
  },
  {
   "t": 232.66,
   "texto": "Um lado marcha, outro lado sangra,",
   "estrofe": 8
  },
  {
   "t": 234.56,
   "texto": "um lado vence, outro lado tranca.",
   "estrofe": 8
  },
  {
   "t": 236.68,
   "texto": "Tem senha quebrada no fundo da pele,",
   "estrofe": 8
  },
  {
   "t": 238.46,
   "texto": "tem grito sem som que ninguém repele.",
   "estrofe": 8
  },
  {
   "t": 240.28,
   "texto": "Tem santo cansado perdendo o halo,",
   "estrofe": 8
  },
  {
   "t": 242.12,
   "texto": "tem cavalo de guerra pedindo intervalo.",
   "estrofe": 8
  },
  {
   "t": 244.4,
   "texto": "Mas quando amanhece, a lâmina acorda,",
   "estrofe": 8
  },
  {
   "t": 245.99,
   "texto": "a cidade chama, a missão transborda.",
   "estrofe": 8
  },
  {
   "t": 248.14,
   "texto": "E ninguém percebe, no brilho do aço,",
   "estrofe": 8
  },
  {
   "t": 249.67,
   "texto": "a marca de asa queimando no braço.",
   "estrofe": 8
  },
  {
